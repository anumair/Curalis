# Dummy, non-secret values for the automated test suite only — points at a
# disposable local Postgres database (see docker-compose.yml), never the
# Neon dev/demo instance. External API keys are fake: tests never make real
# network calls to Google/SendGrid/OpenAI, they mock those call sites.
NODE_ENV=test
PORT=4001
API_BASE_URL=http://localhost:4001
CLIENT_BASE_URL=http://localhost:5173

DATABASE_URL=postgresql://curalis:curalis@localhost:5432/curalis_test?schema=public

JWT_ACCESS_SECRET=test_access_secret_do_not_use_in_prod_00000000
JWT_REFRESH_SECRET=test_refresh_secret_do_not_use_in_prod_0000000

CALENDAR_TOKEN_KEY=0efecf8025810cadf5f9fdcfad6f50987a2154c2e7ecb00da274f8f711b0ca4b

GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4001/api/calendar/google/callback

SENDGRID_API_KEY=SG.test-key-not-real
MAIL_FROM=test@curalis.test
MAIL_FROM_NAME=Curalis Test

OPENAI_API_KEY=sk-test-key-not-real

ADMIN_SEED_EMAIL=admin@curalis.test
